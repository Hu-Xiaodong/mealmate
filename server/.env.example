# 运行环境：dev / test / prod
APP_ENV=dev
# 生产使用 PostgreSQL + Redis（见根目录 docker-compose.yml）
# 本地零依赖启动默认 SQLite
DATABASE_URL=sqlite+aiosqlite:///./mealmate_dev.db
# Redis 存放最近 30 分钟的 AI 会话（滑动过期）。
# 本地未启动 Redis 时可以留空：登录用户会自动降级为读数据库，
# 游客则依赖客户端随请求带来的最近 8 条历史，功能仍可用。
# 本地启动方式：在根目录执行 docker compose up -d redis，
# 然后改成 redis://localhost:6379/0；生产由 docker-compose 注入。
REDIS_URL=
# 生产必须替换为随机长密钥；手机号加密与验证码摘要都由它派生
SECRET_KEY=dev-only-change-me-in-production
# 普通用户会话有效期（天）。60 天免登录；管理员会话另有分钟级配置
SESSION_TTL_DAYS=60
# 仅 dev/test 允许返回固定演示验证码，APP_ENV=prod 时强制关闭
ALLOW_DEV_AUTH_CODE=true
DEV_AUTH_CODE=123456
# dev 下新发布立即公开；生产应设为 false 走审核
AUTO_PUBLISH_POSTS=true
# 是否写入演示饭帖/菜谱，生产必须 false
SEED_DEMO_DATA=true
PUBLIC_BASE_URL=http://127.0.0.1:8000
# 媒体存储：local 写本地磁盘；迁移到云后改为 s3（需实现对应后端）
MEDIA_BACKEND=local
# 媒体存储目录（相对 server 运行目录）
MEDIA_ROOT=./media
# CORS，多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:5174,http://127.0.0.1:5174
# AI：模型地址、密钥、模型名与优先级在管理后台“模型配置”里维护，
# 不再写进环境变量；未启用模型或启用模型调用失败时自动回退到本地规则推荐。
# 每日问答配额：游客更严格，登录用户更宽松。
GUEST_AI_DAILY_LIMIT=5
USER_AI_DAILY_LIMIT=20
# 是否启用每日问答次数限制；false 时只记录次数、不拒绝请求
AI_DAILY_LIMIT_ENABLED=true
RANK_CACHE_SECONDS=10
# 腾讯位置服务 Key（https://lbs.qq.com/ 控制台申请）。
# 只配置在服务端，各客户端通过后端代理使用；留空时地图功能降级为手动填写地址。
# 个人开发者免费额度：每个接口每天 10000 次调用、每秒 5 次查询，仅限非商业用途。
TENCENT_MAP_KEY=
# 腾讯地图 Secret Key（简称 SK）：仅在控制台开启了“签名校验”时填写。
# SK 权限高于 Key，只放服务端，绝不提交到代码仓库。
TENCENT_MAP_SECRET_KEY=
# 腾讯地图接口超时时间，单位秒
MAP_TIMEOUT_SECONDS=6
# 管理后台：首次启动创建超级管理员。密码只从环境变量读取，未配置则不创建。
# 生产环境必须改成强密码，并只允许内网访问后台入口。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-me-to-a-strong-admin-password
# 管理员会话 1 天（1440 分钟）；同一用户名 + 来源地址 10 分钟内失败 5 次锁定 15 分钟
ADMIN_SESSION_TTL_MINUTES=1440
ADMIN_LOGIN_WINDOW_MINUTES=10
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOCK_MINUTES=15
